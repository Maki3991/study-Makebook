# MAKEBOOK 部署配置。复制为 .env 并填入私钥；.env 已被 gitignore，永不提交、永不外发。

# ── 部署参数（必填）──
# lib/schema 锚点值；改动 manifest 后必须用 npm run test:lib 打印的新值替换
MANIFEST_HASH=0x92e96e079279e2a5d21e099f2693513f0e954384407de71ae66f8b853becc6ec
# manifest JSON 的公开 URL（仓库转 public 后可解析）
MANIFEST_URI=https://raw.githubusercontent.com/gmy20060609-jpg/ACL-team/main/public/manifests/frame-01.json
# uint64 秒级 Unix 时间，部署后不可改。任何写死的值都会过期——部署前用
# `date -u -v+72H +%s`（或 GNU: `date -u -d '+72 hours' +%s`）现算一个，并用 `date -u -r <ts>` 复核。
# P1 社区批次用的是 1785024000（2026-07-26 08:00 UTC+8，pitch 当天早晨现场 settle）。
DEADLINE=1785024000

# ── P1 三方分账参数（spec 008；脚本缺省 2500/200）──
MARGIN_BPS=2500
FEE_BPS=200

# ── 角色私钥（必填；地址由脚本派生。仅存在于本文件，不进聊天/视频/截图）──
OPERATOR_KEY=0x
NORTH_KEY=0x
LOOM_KEY=0x
BUYER_A_KEY=0x
BUYER_B_KEY=0x
BUYER_C_KEY=0x
BUYER_D_KEY=0x
BUYER_E_KEY=0x
# P1：品牌应收唯一领取方 / 平台费唯一领取方（feeRecipient，须 ≠ OPERATOR）
CREATOR_KEY=0x
PLATFORM_KEY=0x

# ── 可选覆盖 ──
# INJ_RPC=https://k8s.testnet.json-rpc.injective.network/
# EXPLORER=https://testnet.blockscout.injective.network/
# NORTH_PROFILE_HASH= / LOOM_PROFILE_HASH= / NORTH_QUOTE_HASH= / LOOM_QUOTE_HASH=
# （默认由 cast keccak 对固定字符串确定性生成，见 demo-pipeline.sh）

# ── AI 编译器（前端 /api/compile；未配置/超时/错误时 fixture 降级，页面标 Fixture）──
# 生产环境通过 wrangler secret put 配置（勿写进 wrangler.json）；推理型模型已在代码内关思考+max_tokens 4000
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
