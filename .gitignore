# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# local Codex preview runner
/.codex-dev.*
/.codex-live.*
/.codex-start.*
/.codex-run-dev.cmd

# foundry (contracts/) — restore via `forge install --no-git` per contracts/README.md
/contracts/lib/
/contracts/out/
/contracts/cache/
/contracts/broadcast/

# secrets & local deployment state — 私钥永不进仓库
.env
deployments/state.anvil.json
deployments/receipts/anvil-*
tsconfig.tsbuildinfo

# predictions SPA build output
predictions/dist/

# 本地调试与快照产物（spec 009 §8.2）
kimi-debug-session_*.zip
t7-t9-snapshots.txt
visual-snapshots.txt
